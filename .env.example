# Copia este archivo como .env.local y completa con los datos de tu proyecto
# de Supabase (Project Settings → API). Solo claves PÚBLICAS: nunca la clave
# secreta ni la service_role. .env.local no se sube a git.
EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
